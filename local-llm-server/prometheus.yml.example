# Minimal Prometheus scrape config for Local LLM Cloud.
# Drop into /etc/prometheus/prometheus.yml (or merge the scrape_configs
# entry into your existing config).

global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - /etc/prometheus/local-llm-alerts.yml

scrape_configs:
  - job_name: "local-llm-cloud"
    static_configs:
      - targets: ["127.0.0.1:8080"]
    metrics_path: /metrics

